# 监听地址。本机开发保持 127.0.0.1。
# 非回环（含 Docker 的 0.0.0.0）必须同时设置 AUTH_PASSWORD，否则拒绝启动。
HOST=127.0.0.1
PORT=7710
# 笔记库文件夹（仓库外，不入 git；首次启动为空会提示导入示例库）
VAULT_DIR=~/MarkGraph-vault

# 单用户访问口令（F21）。回环可不设；局域网 / Docker 必设。
# AUTH_PASSWORD=change-me
# Cookie 签名（≥32 字符）。不设则每次启动随机，重启后需重新登录。
# AUTH_SECRET=please-replace-with-a-long-random-string
# 仅回环允许 AUTH_DISABLED=1 跳过口令。
# AUTH_DISABLED=1
# DSM / 网络盘绑定挂载没有 inotify 时打开：
# CHOKIDAR_USEPOLLING=1

# AI 自动富集（可选，Phase 2）：OpenAI 兼容接口，支持 newAPI 等网关。
# 四项都配置后，保存笔记会自动生成标签/摘要/链接；不配置则 AI 功能静默关闭。
# 这四项也可以在应用「设置」(⌘,) 里配置并热生效，UI 内设置优先于本文件。
# AI_BASE_URL=https://your-gateway.example.com/v1
# AI_API_KEY=sk-xxx
# AI_CHAT_MODEL=glm-4.7
# AI_EMBED_MODEL=embedding-3
# 保存后到触发富集的防抖毫秒数（默认 8000，一般不用改）
# AI_DEBOUNCE_MS=8000
